    "@vitejs/plugin-vue-jsx": "^5",
    "@vue/test-utils": "^2",
    "happy-dom": "^20",
    "sass": "^1",
    "typescript": "^*",
    "vite": "^8",
    "vitest": "^5",
    "vue-tsc": "^3"
  }
}
