target/

# webui build output (packages/webui builds into the repo-root dist/webui;
# the release binary embeds it at compile time via include_dir!)
dist/

# node toolchain (pnpm workspace; installs stay local to the checkout)
node_modules/

# backup files generated by rustfmt
**/*.rs.bk

# editor config files and directories
*.iml
/.idea/
/.vscode/

# dev files
cache/

# deploy secrets (compose reads deploy/.env; see README deploy section)
.env
deploy/.env

# celestia-devtools: staged-on-demand shared justfile recipes (celestia-devtools init / just fetch)
/.just/
/celestia-devtools.just
